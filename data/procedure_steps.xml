<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="procedure_step_01" model="aq.portal.procedure.step">
        <field name="sequence">10</field>
        <field name="name">1. Cotización y aprobación</field>
        <field name="required_evidence">Cotización aceptada por el cliente (correo u orden).</field>
    </record>
    <record id="procedure_step_02" model="aq.portal.procedure.step">
        <field name="sequence">20</field>
        <field name="name">2. Contrato o documento comercial</field>
        <field name="required_evidence">Contrato firmado, orden de compra o cotización aceptada.</field>
    </record>
    <record id="procedure_step_03" model="aq.portal.procedure.step">
        <field name="sequence">30</field>
        <field name="name">3. Anticipo o condición de arranque</field>
        <field name="required_evidence">Comprobante de anticipo o condición de arranque cumplida.</field>
    </record>
    <record id="procedure_step_04" model="aq.portal.procedure.step">
        <field name="sequence">40</field>
        <field name="name">4. Expediente del cliente</field>
        <field name="required_evidence">Carpeta con datos fiscales, contactos, contrato y propuesta.</field>
    </record>
    <record id="procedure_step_05" model="aq.portal.procedure.step">
        <field name="sequence">50</field>
        <field name="name">5. Reunión de inicio</field>
        <field name="required_evidence">Minuta de kickoff.</field>
    </record>
    <record id="procedure_step_06" model="aq.portal.procedure.step">
        <field name="sequence">60</field>
        <field name="name">6. Definición de responsables</field>
        <field name="required_evidence">Responsable interno, contacto del cliente y equipo registrados.</field>
    </record>
    <record id="procedure_step_07" model="aq.portal.procedure.step">
        <field name="sequence">70</field>
        <field name="name">7. Alcance y entregables</field>
        <field name="required_evidence">Anexo de alcance y lista de entregables con criterios de aceptación.</field>
    </record>
    <record id="procedure_step_08" model="aq.portal.procedure.step">
        <field name="sequence">80</field>
        <field name="name">8. Plan de trabajo</field>
        <field name="required_evidence">Plan con fechas relevantes y próximo entregable.</field>
    </record>
    <record id="procedure_step_09" model="aq.portal.procedure.step">
        <field name="sequence">90</field>
        <field name="name">9. Registro de acuerdos</field>
        <field name="required_evidence">Acuerdos de cada reunión registrados como pendientes con responsable y fecha.</field>
    </record>
    <record id="procedure_step_10" model="aq.portal.procedure.step">
        <field name="sequence">100</field>
        <field name="name">10. Control de cambios</field>
        <field name="required_evidence">Solicitudes fuera de alcance clasificadas, estimadas y autorizadas.</field>
    </record>
    <record id="procedure_step_11" model="aq.portal.procedure.step">
        <field name="sequence">110</field>
        <field name="name">11. Registro de horas</field>
        <field name="required_evidence">Horas ejecutadas registradas y relacionadas con la bolsa/contrato.</field>
    </record>
    <record id="procedure_step_12" model="aq.portal.procedure.step">
        <field name="sequence">120</field>
        <field name="name">12. Facturación</field>
        <field name="required_evidence">Facturas programadas, emitidas y enviadas con evidencia.</field>
    </record>
    <record id="procedure_step_13" model="aq.portal.procedure.step">
        <field name="sequence">130</field>
        <field name="name">13. Validación del cliente</field>
        <field name="required_evidence">Evidencia de validación de entregables.</field>
    </record>
    <record id="procedure_step_14" model="aq.portal.procedure.step">
        <field name="sequence">140</field>
        <field name="name">14. Acta de aceptación</field>
        <field name="required_evidence">Acta de aceptación firmada o correo de conformidad.</field>
    </record>
    <record id="procedure_step_15" model="aq.portal.procedure.step">
        <field name="sequence">150</field>
        <field name="name">15. Cierre o transición a soporte</field>
        <field name="required_evidence">Documento de cierre, entrega de accesos/archivos y esquema de soporte.</field>
    </record>
</odoo>
