<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_portal_daily" model="ir.cron">
        <field name="name">Portal administrativo: alertas, rutinas y estados (diario)</field>
        <field name="model_id" ref="model_aq_portal_alert"/>
        <field name="state">code</field>
        <field name="code">model.cron_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
