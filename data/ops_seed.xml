<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="partner_getting_ready" model="res.partner"><field name="name">Getting Ready</field><field name="is_company" eval="True"/></record>
    <record id="ops_project_stonia" model="aq.ops.project"><field name="name">Stonia · Implementación y estabilización</field><field name="partner_id" ref="partner_som"/><field name="service_type">implementacion</field><field name="template_id" ref="ops_template_implementacion"/><field name="pm_id" ref="member_direccion"/><field name="objective">Inventario, migraciones, UAT, liberaciones y control de placas.</field><field name="admin_project_id" eval="ref('project_som')"/><field name="admin_project_ref">SOM Group / Stonia · Proyecto Odoo</field></record>
    <record id="ops_project_sai" model="aq.ops.project"><field name="name">SAI · Proyecto por etapas (regulado)</field><field name="partner_id" ref="partner_sai"/><field name="service_type">regulado</field><field name="template_id" ref="ops_template_regulado"/><field name="pm_id" ref="member_direccion"/><field name="objective">Historias de usuario, dependencias, control de cambios, validación departamental y evidencia regulatoria.</field><field name="admin_project_id" eval="ref('project_sai')"/><field name="admin_project_ref">SAI · Proyecto Odoo</field></record>
    <record id="ops_project_hexagonos" model="aq.ops.project"><field name="name">Hexágonos · Soporte productivo</field><field name="partner_id" ref="partner_hexagonos"/><field name="service_type">soporte</field><field name="template_id" ref="ops_template_soporte"/><field name="pm_id" ref="member_direccion"/><field name="objective">Manufactura, incidencias, QA, liberaciones y saneamiento de datos.</field><field name="admin_project_id" eval="ref('project_hexagonos')"/><field name="admin_project_ref">Hexágonos Mexicanos · Proyecto Odoo</field></record>
    <record id="ops_project_ooak" model="aq.ops.project"><field name="name">One of a Kind · Activos y catálogo</field><field name="partner_id" ref="partner_ooak"/><field name="service_type">creativo</field><field name="template_id" ref="ops_template_creativo"/><field name="pm_id" ref="member_direccion"/><field name="objective">Activos, catálogo, revisiones y aprobación visual.</field><field name="admin_project_id" eval="ref('project_ooak')"/><field name="admin_project_ref">One of a Kind · Proyecto Odoo</field></record>
    <record id="ops_project_getting_ready" model="aq.ops.project"><field name="name">Getting Ready · Cierre y handoff</field><field name="partner_id" ref="partner_getting_ready"/><field name="service_type">cierre</field><field name="template_id" ref="ops_template_cierre"/><field name="pm_id" ref="member_direccion"/><field name="objective">Cierre, transición, pendientes conocidos y handoff.</field></record>
    <record id="ops_param_retention_audit" model="ir.config_parameter"><field name="key">aq_ops.retention_days_audit</field><field name="value">1825</field></record>
    <record id="ops_param_retention_logs" model="ir.config_parameter"><field name="key">aq_ops.retention_days_automation_logs</field><field name="value">180</field></record>
    <record id="ops_auto_anomalies" model="aq.ops.automation"><field name="name">Detección de anomalías (picos de horas, reprogramaciones, agotamiento pronosticado, SLA en riesgo)</field><field name="code">anomalies</field><field name="trigger">schedule_daily</field><field name="action_type">builtin</field><field name="sequence">200</field><field name="critical" eval="True"/><field name="owner_id" ref="member_direccion"/></record>
    <record id="ops_auto_retention" model="aq.ops.automation"><field name="name">Políticas de retención (notificaciones, bitácora, historial, sesiones)</field><field name="code">retention</field><field name="trigger">schedule_daily</field><field name="action_type">builtin</field><field name="sequence">210</field><field name="critical" eval="True"/><field name="owner_id" ref="member_direccion"/></record>
    <record id="ops_integration_teams" model="aq.ops.integration"><field name="name">Microsoft Teams · webhook entrante</field><field name="kind">teams</field><field name="enabled" eval="False"/><field name="notes">Pegue la URL del conector entrante del canal. Se envían notificaciones de prioridad alta/crítica.</field></record>
    <record id="ops_integration_slack" model="aq.ops.integration"><field name="name">Slack · webhook entrante</field><field name="kind">slack</field><field name="enabled" eval="False"/></record>
    <record id="ops_integration_whatsapp" model="aq.ops.integration"><field name="name">WhatsApp · proveedor por webhook</field><field name="kind">whatsapp</field><field name="enabled" eval="False"/><field name="notes">Conecte un proveedor (p. ej. Twilio/Meta vía middleware) que reciba {message, to}.</field></record>
</odoo>
