<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="param_stale_days" model="ir.config_parameter">
        <field name="key">aq_admin_portal.stale_days</field>
        <field name="value">5</field>
    </record>
    <record id="param_warn_days" model="ir.config_parameter">
        <field name="key">aq_admin_portal.warn_days</field>
        <field name="value">7</field>
    </record>
    <record id="param_prospect_days" model="ir.config_parameter">
        <field name="key">aq_admin_portal.prospect_days</field>
        <field name="value">7</field>
    </record>
    <record id="param_depletion_threshold" model="ir.config_parameter">
        <field name="key">aq_admin_portal.depletion_threshold</field>
        <field name="value">80</field>
    </record>
    <record id="param_session_hours" model="ir.config_parameter">
        <field name="key">aq_admin_portal.session_hours</field>
        <field name="value">12</field>
    </record>
    <record id="param_portal_path" model="ir.config_parameter">
        <field name="key">aq_admin_portal.portal_path</field>
        <field name="value">/admin-portal</field>
    </record>
    <!-- Parámetros que pueden preexistir (set_param desde código o UI): se siembran con set_param,
         que es idempotente, y solo al instalar (noupdate); el código usa "1" como valor por defecto. -->
    <function model="ir.config_parameter" name="set_param" eval="('aq_ops.auto_confirm_agreements', '1')"/>
    <function model="ir.config_parameter" name="set_param" eval="('aq_ops.auto_approve_decisions', '1')"/>
</odoo>
