<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_portal_reset" model="mail.template">
        <field name="name">Portal administrativo: restablecer contraseña</field>
        <field name="model_id" ref="aq_admin_portal.model_aq_portal_user"/>
        <field name="subject">Acceso al Portal Administrativo AlphaQueb</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; color:#333;">
    <p>Hola <t t-out="object.name"/>,</p>
    <p>Recibiste este correo porque se creó tu cuenta o se solicitó restablecer tu contraseña del
       <b>Portal de Control Administrativo de AlphaQueb Consulting</b>.</p>
    <p style="margin:24px 0;">
        <a t-att-href="ctx.get('reset_link')" style="background:#714B67;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none;">
            Establecer mi contraseña
        </a>
    </p>
    <p>Si el botón no funciona, copia este enlace en tu navegador:<br/>
       <t t-out="ctx.get('reset_link')"/></p>
    <p>El enlace vence en 2 horas. Si no solicitaste este acceso, ignora este mensaje.</p>
    <p>— AlphaQueb Consulting</p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
