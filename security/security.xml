<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_aq_portal" model="ir.module.category">
        <field name="name">Portal administrativo AlphaQueb</field>
        <field name="sequence">60</field>
    </record>
    <record id="privilege_aq_portal" model="res.groups.privilege">
        <field name="name">Portal administrativo</field>
        <field name="category_id" ref="module_category_aq_portal"/>
        <field name="sequence">60</field>
    </record>
    <record id="group_aq_portal_manager" model="res.groups">
        <field name="name">Administrador del portal</field>
        <field name="privilege_id" ref="privilege_aq_portal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Puede gestionar usuarios externos del portal y todos los controles desde el backend de Odoo.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_aq_portal_manager'))]"/>
    </record>
</odoo>
